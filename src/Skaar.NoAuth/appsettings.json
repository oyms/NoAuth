{
  "NoAuth": {
    "Issuer": "https://noauth",
    "BaseUrl": "https://localhost:44367",
    "Paths": {
      "FrontPage": "/",
      "Favicon": "/favicon.png",
      "Discovery": "/.well-known/openid-configuration",
      "AuthorizationServerMetadata": "/.well-known/oauth-authorization-server",
      "Jwks": "/.well-known/openid-configuration/jwks",
      "Token": [
        "/connect/token",
        "/v1/oauth2/tokens"
      ],
      "Authorize": "/connect/authorize",
      "Login": "/connect/login",
      "EndSession": "/connect/endsession",
      "LogOutRedirect": "/fallback/session_ended",
      "Introspection": "/connect/introspect",
      "Revocation": "/connect/revoke",
      "Registration": "/connect/register",
      "UserInfo": "/connect/userinfo",
      "TokenDump": "/api/tokens",
      "LogDump": "/api/log",
      "ConfigDump": "/api/configuration",
      "TokenRequestApi": "/api/token",
      "LoginProfile": "/api/loginprofiles"
    },
    "Oidc": {
      "RememberUser": false,
      "Strategy": "WebForm"
    },
    "UseReferenceTokens": false,
    "Strict": false,
    "DeriveUrlsFromRequest": false,
    "TokenTtlInSeconds": 36000
  }
}
