<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Skaar.NoAuth</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>noauth</ToolCommandName>
        <Description>A fake OAuth2/OpenID Connect server to run locally.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS0436: Skaar.Fodselsnummer exposes public copies of the Skaar.ValueType types. Remove when fixed upstream. -->
        <NoWarn>$(NoWarn);CS1591;CA1822;CS0436</NoWarn>
        <VersionPrefix>1.0.1</VersionPrefix>
        <Product>No Auth</Product>
        <Authors>Skaar</Authors>
        <PackageTags>OAuth OIDC Testing Fake Login Security</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <RepositoryUrl>https://github.com/oyms/NoAuth</RepositoryUrl>
        <PackageProjectUrl>https://github.com/oyms/NoAuth</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>
            1.0.0: Initial release.
        </PackageReleaseNotes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
        <Content Update="loginProfiles.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
        <Content Update="loginProfiles.schema.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Skaar.NoAuth.Tests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Cert\selfsign.pfx" LogicalName="Cert.selfsign.pfx" />
        <EmbeddedResource Include="Endpoints\Views\*.html" LogicalName="Views.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Endpoints\Views\favicon.png" LogicalName="Views.favicon.png" />
        <None Include="Endpoints\Views\favicon.png" Pack="true" PackagePath="icon.png" Visible="false" />
        <EmbeddedResource Include="loginProfiles.schema.json" LogicalName="loginProfiles.schema.json" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
      <PackageReference Include="Skaar.Fodselsnummer" Version="2.1.0" />
      <PackageReference Include="Skaar.ValueType" Version="3.0.1" />
    </ItemGroup>

</Project>
